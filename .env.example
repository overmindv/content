CONTENT_SERVICE_NAME=content
CONTENT_ENV=local
CONTENT_VERSION=dev
CONTENT_HTTP_ADDR=:8080
CONTENT_GRPC_ADDR=:9090
CONTENT_HTTP_READ_TIMEOUT=5s
CONTENT_HTTP_WRITE_TIMEOUT=10s
CONTENT_SHUTDOWN_TIMEOUT=10s
CONTENT_DB_DSN=postgres://postgres:change-me@localhost:5432/content?sslmode=disable
CONTENT_POSTGRES_DB=content
CONTENT_POSTGRES_USER=postgres
CONTENT_POSTGRES_PASSWORD=change-me
CONTENT_DB_MAX_OPEN_CONNS=20
CONTENT_DB_MAX_IDLE_CONNS=10
CONTENT_DB_CONN_MAX_LIFETIME=30m
CONTENT_KAFKA_ENABLED=true
CONTENT_KAFKA_BROKERS=localhost:9092
CONTENT_KAFKA_TOPIC=content.content-item-events
CONTENT_KAFKA_CLIENT_ID=content
CONTENT_METRICS_NAMESPACE=content
