BUMBLEBEE_SERVICE_NAME=bumblebee
BUMBLEBEE_ENV=local
BUMBLEBEE_VERSION=dev
BUMBLEBEE_HTTP_ADDR=:8080
BUMBLEBEE_GRPC_ADDR=:9090
BUMBLEBEE_HTTP_READ_TIMEOUT=5s
BUMBLEBEE_HTTP_WRITE_TIMEOUT=10s
BUMBLEBEE_SHUTDOWN_TIMEOUT=10s
BUMBLEBEE_DB_DSN=postgres://postgres:change-me@localhost:5432/bumblebee?sslmode=disable
BUMBLEBEE_POSTGRES_DB=bumblebee
BUMBLEBEE_POSTGRES_USER=postgres
BUMBLEBEE_POSTGRES_PASSWORD=change-me
BUMBLEBEE_DB_MAX_OPEN_CONNS=20
BUMBLEBEE_DB_MAX_IDLE_CONNS=10
BUMBLEBEE_DB_CONN_MAX_LIFETIME=30m
BUMBLEBEE_KAFKA_ENABLED=true
BUMBLEBEE_KAFKA_BROKERS=localhost:9092
BUMBLEBEE_KAFKA_TOPIC=bumblebee.content-item-events
BUMBLEBEE_KAFKA_CLIENT_ID=bumblebee
BUMBLEBEE_METRICS_NAMESPACE=bumblebee
