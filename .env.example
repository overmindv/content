# Паркер (инфраструктура): HTTP, лог, Postgres, Kafka-брокеры
SERVICE_NAME=content
HTTP_ADDR=:8080
ENV=local
LOG_LEVEL=info
DATABASE_URL=postgres://postgres:change-me@localhost:5432/content?sslmode=disable
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# Бизнес-конфиг content
GRPC_ADDR=:9090
KAFKA_ENABLED=true
KAFKA_TOPIC=content.content-item-events
