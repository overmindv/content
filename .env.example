# Паркер (инфраструктура): HTTP, лог, Postgres, Kafka-брокеры
SERVICE_NAME=content
HTTP_ADDR=:8080
ENV=local
LOG_LEVEL=info
DATABASE_URL=postgres://postgres:change-me@localhost:5432/content?sslmode=disable
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# Бизнес-конфиг content
GRPC_ADDR=:9090
CONTENT_GRPC_SERVICE_TOKEN=
CONTENT_ENTITIES_URL=
CONTENT_REVIEW_CANDIDATES_URL=
CONTENT_REVIEW_CANDIDATES_TOKEN=
CONTENT_MEDIA_URL=
CONTENT_MEDIA_TOKEN=
KAFKA_ENABLED=true
KAFKA_TOPIC=content.content-item-events
CONTENT_ACTIVITY_ENABLED=true
KAFKA_CONTENT_MATERIAL_TOPIC=content.material.v1
KAFKA_CONTENT_CONTRIBUTION_TOPIC=content.contribution.v1
KAFKA_CONTENT_LEARNING_TOPIC=content.learning.v1
